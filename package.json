    "apexcharts": "^5.16.0",
    "firebase": "^12.16.0",
    "ng-apexcharts": "^2.4.0",
    "ngx-otp-input": "^2.0.0",
    "ngx-pagination": "^6.0.3",
    "rxjs": "~7.8.0",
